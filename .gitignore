# ---------- 本地路由器地址配置 (含个人 SSH 别名/IP, 不入库; 由脚本首次运行时生成) ----------
router-target.conf

# ---------- 第三方固件二进制 (体积大, 不入库; 由 router_watch.sh 自动下载) ----------
*.itb

# ---------- 打包后的 kit (含 SSH 公钥 / OpenClash 配置等敏感信息, 不入库) ----------
kit.tar.gz
router-kit-data.tar.gz
dist/

# ---------- 升级前配置快照 (sysupgrade -b, 含全部运行期配置) ----------
backups/

# ---------- 官方 sha256sums 缓存 ----------
sha256sums

# ---------- 运行日志 ----------
watch.log

# ---------- 临时注入 kit (含 root shadow hash, 仅升级时本地生成) ----------
/tmp/kit_injected.tar.gz
/tmp/kit_build/

# ---------- macOS ----------
.DS_Store
